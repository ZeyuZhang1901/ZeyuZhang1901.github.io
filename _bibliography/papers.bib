@misc{zhang2026fabrication,
  sortdate={2026-11-11},
  title={One Fabrication Is Enough: A Fake News Article Changes the Forecasts of LLM Forecasting Systems},
  author={Zhang, Zeyu and Stadie, Bradly C.},
  year={2026},
  eprint={2611.15102},
  archivePrefix={arXiv},
  url={https://arxiv.org/abs/2611.15102},
  arxiv={2611.15102},
  pdf={2611.15102v1.pdf},
  preview={fabrication2026_preview.png},
  bibtex_show={true},
  selected={true},
  additional_info={Preprint},
  category={Preprints},
  nick={One Fabrication},
  blurb={An attacker who knows only the forecasting question publishes one fake news article; it reverses 74–82\% of opposing forecasts on every frontier model tested, and the strongest published defenses are cheaply bypassed.},
  abstract={LLMs are increasingly used for forecasting, and the best forecasting systems retrieve news as evidence to strengthen their predictions. This also opens them to attack. We study the weakest attacker of this kind, who knows only the forecasting question and publishes fabricated news articles, with no access to the model, the retriever or its queries. We evaluate how far this attack reaches on stock questions and real prediction-market questions. Once the article is in the model's context, it reverses 74\% to 82\% of the forecasts that opposed it, on every frontier model we tested. The model cannot verify the fabrication and follows it anyway. Retrieval is the attack's entry point, and the systems built to retrieve well are the most exposed: the architectures of two leading deployed forecasting systems, whose agents search for every related article, retrieve the fabricated one in about 90\% of runs. Accuracy cannot reveal this harm: the attacked forecaster is right when the attacker's direction turns out right and wrong otherwise, so its average accuracy barely changes while its forecasts follow the attacker's guess. We also propose a second attacker, who publishes two articles that argue opposite directions to make the forecaster unsure. The model does not hedge; it returns a confident forecast in a direction the attacker no longer controls. We then evaluate the two strongest published retrieval-time defenses, passage filtering and partitioned retrieval. Each stops the one-article attack but is bypassed by a one-prompt change to the attack. Together they stop both bypasses at four articles, but sixteen distorted copies beat them, and they change 29\% of clean decisions and discard 39\% of the genuine news. Partitioned retrieval also requires control of the retrieval index. Systems that search the open web have no such control and are left with the filter alone. For them, the attack still works.}
}

@article{zhang2026leakage,
  sortdate={2026-10-29},
  title={Temporal Leakage in LLM Backtesting: Measurement, Validation, and Adjusted Scores},
  author={Zhang, Zeyu and Stadie, Bradly C.},
  journal={Transactions on Machine Learning Research},
  year={2026},
  eprint={2608.02985},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  url={https://arxiv.org/abs/2608.02985},
  arxiv={2608.02985},
  code={https://github.com/ZeyuZhang1901/Temporal-Leakage-Backtesting},
  pdf={temporal_leakage_2026.pdf},
  preview={leakage2026_preview.png},
  bibtex_show={true},
  selected={true},
  category={First Author Publications},
  nick={Leakage Audit},
  blurb={Recency mimics leakage, so no passive backtest can separate leakage from genuine skill; two estimators—a known cutoff or a clean control model—yield a leakage-adjusted score.},
  abstract={The standard check for contamination in LLM backtests is simple: compare scores before and after the training cutoff. We show this check is uninformative. Four flagship models fail it on questions they cannot have memorized: every scored question resolved after their cutoffs. The reason is structural. Models legitimately know more about times near their cutoff, so recency mimics leakage, and we prove no passive backtest can separate the two from genuine skill. Measurement, not just detection, requires information from outside the backtest. We supply it in two forms. A known cutoff identifies leakage at the boundary; a matched clean control identifies it globally and yields a leakage-adjusted score. Under a convex-pull model, leakage concentrates on outcomes that surprised the crowd and that training covered well. Partial memorization gives a large part of the full inflation. In twin models with planted leakage, the estimators detect and localize it, track its dose, and return null on clean questions. On frontier models, the estimators detect one cutoff-localized signature. They find no significant leakage at the tested boundaries in five models with positive naive gaps. Backtests need not be discarded; they need one defensible reference.}
}

@inproceedings{zhang2026tempo,
  sortdate={2026-09-24},
  title={TEMPO: Temporal Enforcement via Mode-Separated Policy Optimization for Trustworthy LLM Backtesting},
  author={Zhang, Zeyu and Stadie, Bradly C.},
  booktitle={Advances in Neural Information Processing Systems},
  year={2026},
  eprint={2605.18843},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  url={https://arxiv.org/abs/2605.18843},
  arxiv={2605.18843},
  pdf={2605.18843v1.pdf},
  code={https://github.com/nu-snail/TEMPO},
  preview={tempo2026_preview.png},
  bibtex_show={true},
  selected={true},
  category={First Author Publications},
  nick={TEMPO},
  blurb={GRPO post-training with a two-mode reward that drives post-cutoff claims to zero before optimizing the task on clean evidence, cutting leakage from 2–13\% to 0.6–3.7\%.},
  abstract={Backtesting large language models on historical events requires reasoning exclusively from information available before a specified cutoff date. Yet models routinely leak post-cutoff knowledge from pre-training into their reasoning, inflating apparent accuracy and undermining evaluation validity. Prompt-based constraints fail when suppressed content is causally related to the prediction, and knowledge unlearning cannot address this problem because temporal compliance is instance-specific: the same fact may be legitimate evidence for one cutoff date and a violation for another. Rather than erasing knowledge, the model must learn temporal discipline: selecting evidence conditioned on each instance's cutoff date. We propose TEMPO (Temporal Enforcement via Mode-separated Policy Optimization), which trains this discipline via two contributions: (1) a two-mode reward where a leakage mode drives post-cutoff claims to zero as a hard prerequisite before a performance mode optimizes task performance; and (2) a GRPO-based training pipeline that enables the model to discover temporally valid reasoning strategies. We prove that training monotonically decreases leakage, converges to the leak-free optimum, and improves task performance once compliance is achieved. On three prediction tasks and two models, TEMPO reduces leakage from 2–13\% to 0.6–3.7\% across all conditions, with task performance improving 6–13\% where strong pre-cutoff signals exist and maintained where the prediction task is inherently difficult from valid information alone.}
}

@inproceedings{zhang2026allleaks,
  sortdate={2026-08-20},
  title={All Leaks Count, Some Count More: Interpretable Temporal Contamination Detection and Mitigation in LLM Backtesting},
  author={Zhang, Zeyu and Chen, Ryan and Stadie, Bradly C.},
  booktitle={Findings of the Association for Computational Linguistics: EMNLP 2026},
  year={2026},
  eprint={2602.17234},
  archivePrefix={arXiv},
  primaryClass={cs.AI},
  url={https://arxiv.org/abs/2602.17234},
  arxiv={2602.17234},
  pdf={2602.17234v2.pdf},
  code={https://github.com/ZeyuZhang1901/TimeSPEC},
  preview={timespec2026_preview.png},
  bibtex_show={true},
  selected={true},
  category={First Author Publications},
  nick={TimeSPEC},
  blurb={Shapley-DCLR measures how much of a model’s decision-driving reasoning is contaminated; TimeSPEC grounds predictions entirely in pre-cutoff evidence, cutting leakage by 83–89\%.},
  abstract={Backtesting LLMs on resolved events assumes models reason only from pre-cutoff knowledge, yet pretrained models inevitably leak post-cutoff knowledge. We introduce a claim-level evaluation framework that decomposes prediction rationales into atomic claims and applies Shapley values to quantify each claim's decision impact, yielding **Shapley-DCLR** (Shapley-weighted Decision-Critical Leakage Rate) – an interpretable metric measuring what fraction of decision-driving reasoning is contaminated. We further propose **TimeSPEC** (Time-Supervised Prediction with Extracted Claims), an inference-time architecture that interleaves temporally-filtered retrieval with claim-level supervision, producing predictions grounded entirely in pre-cutoff evidence. Across three LLMs, the ablation experiments confirm retrieval and supervision are jointly necessary; and a three-task probe further illstrates that the performance cost of temporal enforcement scales with each task's reliance on post-cutoff information.}
}

@inproceedings{zhang2023unified,
  sortdate={2023-09-21},
  title={Unified Off-Policy Learning to Rank: a Reinforcement Learning Perspective},
  author={Zhang, Zeyu and Su, Yi and Yuan, Hui and Wu, Yiran and Balasubramanian, Rishab and Wu, Qingyun and Wang, Huazheng and Wang, Mengdi},
  booktitle={Advances in Neural Information Processing Systems},
  volume={36},
  pages={19887--19907},
  year={2023},
  publisher={Curran Associates, Inc.},
  editor={A. Oh and T. Naumann and A. Globerson and K. Saenko and M. Hardt and S. Levine},
  url={https://arxiv.org/abs/2306.07528},
  arxiv={2306.07528},
  pdf={https://proceedings.neurips.cc/paper_files/paper/2023/file/3f1b6e97a5eb3b10e6b0c99b022988eb-Paper-Conference.pdf},
  code={https://github.com/ZeyuZhang1901/Unified-Off-Policy-LTR-Neurips2023},
  preview={CUOLR2023_preview.png},
  bibtex_show={true},
  selected={true},
  category={First Author Publications},
  nick={Off-Policy LTR},
  blurb={Casts ranking under general click models as an MDP, so offline RL learns from biased logged clicks without click-model-specific debiasing.},
  abstract={Off-policy Learning to Rank (LTR) aims to optimize a ranker from data collected by a deployed logging policy. However, existing off-policy learning to rank methods often make strong assumptions about how users generate the click data, i.e., the click model, and hence need to tailor their methods specifically under different click models. In this paper, we unified the ranking process under general stochastic click models as a Markov Decision Process (MDP), and the optimal ranking could be learned with offline reinforcement learning (RL) directly. Building upon this, we leverage offline RL techniques for off-policy LTR and propose the Click Model-Agnostic Unified Off-policy Learning to Rank (CUOLR) method, which could be easily applied to a wide range of click models. Through a dedicated formulation of the MDP, we show that offline RL algorithms can adapt to various click models without complex debiasing techniques and prior knowledge of the model. Results on various large-scale datasets demonstrate that CUOLR consistently outperforms the state-of-the-art off-policy learning to rank algorithms while maintaining consistency and robustness under different click models.}
}

@inproceedings{chen2025lamp,
  sortdate={2026-01-22},
  title={LAMP: Extracting Local Decision Surfaces From Large Language Models},
  author={Chen*, Ryan and Ko*, Youngmin and Cho, Catherine and Zhang, Zeyu and Chung, Sunny and Giuffré, Mauro and Shung, Dennis L. and Stadie, Bradly C.},
  booktitle={Proceedings of The 29th International Conference on Artificial Intelligence and Statistics},
  series={Proceedings of Machine Learning Research},
  volume={300},
  publisher={PMLR},
  year={2026},
  eprint={2505.11772},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  url={https://arxiv.org/abs/2505.11772},
  arxiv={2505.11772},
  pdf={2044_LAMP_Extracting_Local_Dec.pdf},
  preview={lamp2025_preview.png},
  bibtex_show={true},
  selected={true},
  spotlight={true},
  category={Co-authored Publications and Preprints},
  nick={LAMP},
  blurb={Treats an LLM’s own stated factors as coordinates and fits a local linear decision surface, without gradients or internal access, to test whether its predictions follow those factors.},
  abstract={We introduce LAMP (Local Attribution Mapping Probe), a method that shines light onto a black-box language model's decision surface and studies how reliably a model maps its stated reasons to its reported predictions by approximating a decision surface. LAMP treats the model's own self-reported explanations as a coordinate system and fits a locally linear surrogate that links those weights to the model's output. By doing so, it reveals how much the stated factors steer the model's decisions. We apply LAMP to three tasks: sentiment analysis, controversial-topic detection, and safety-prompt auditing. Across these tasks, LAMP reveals that many language models' locally approximated linear decision landscapes overall agree with human judgments on explanation quality and, on a clinical case-file data set, align with expert assessments. Since LAMP operates without requiring access to model gradients, logits, or internal activations, it serves as a practical and lightweight framework for auditing proprietary language models, and enabling assessment of whether a model appears to behave consistently with the explanations it provides.}
}
